# --- ビルド成果物（ローカルでクロスコンパイルして配る。gitには入れない） ---
webapp/go/isupipe
build/
*.test

# --- 環境依存（isuenv が毎回振り直す） ---
hosts.generated.mk
.env.local

# --- 計測の巨大な生ログ（要約は measurements/ にコミットする） ---
measurements/**/raw/

# --- OS ---
.DS_Store

# --- 秘密情報（AMI 由来でも公開リポジトリには入れない。サーバー側に既にあるので deploy には不要） ---
etc/*/nginx/tls/*.key
etc/*/mysql/debian.cnf
